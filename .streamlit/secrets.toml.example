# 이 파일을 secrets.toml 로 복사한 뒤 값을 채워 넣으세요.
# secrets.toml 은 .gitignore 에 포함되어 있어 깃허브에 올라가지 않습니다.

[google]
client_id = "xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
# 구글 클라우드 콘솔의 '승인된 리디렉션 URI'와 정확히 같아야 합니다.
# 내 컴퓨터에서 실행: http://localhost:8501
# Streamlit Cloud 배포: https://<앱 이름>.streamlit.app
redirect_uri = "http://localhost:8501"
